PRINT_AGENT_CALLBACK_URL=https://your-project.supabase.co/functions/v1/print-agent
PRINT_AGENT_API_KEY=your-print-agent-api-key
POLL_INTERVAL_SECONDS=2
PRINTER_PORT=9100
PRINTER_TIMEOUT_SECONDS=5
MAX_CONCURRENT_JOBS=3
LOG_LEVEL=INFO

# ERP integration controls
ERP_ENABLED=false
ERP_AUTH_MODE=none
# JSON map: {"endpoint_key":{"url":"https://erp.example.com/api/orders","method":"POST","timeout_seconds":10}}
ERP_ENDPOINTS_JSON={"erp_box_fetch":{"url":"http://192.168.16.201/ka_shlyapnikova/hs/BMJERP/boxes/GET","method":"GET","timeout_seconds":10},"completion_event":{"url":"http://192.168.16.201/ka_shlyapnikova/hs/BMJERP/event-completion/POST","method":"POST","timeout_seconds":30}}

# Optional auth secrets (used based on ERP_AUTH_MODE)
ERP_AUTH_BEARER_TOKEN=
ERP_AUTH_BASIC_USERNAME=
ERP_AUTH_BASIC_PASSWORD=
# JSON object for ERP_AUTH_MODE=static_headers, e.g. {"X-Api-Key":"secret","X-Tenant":"acme"}
ERP_AUTH_STATIC_HEADERS_JSON={}

# ERP retry and timeout settings
ERP_DEFAULT_TIMEOUT_SECONDS=10
ERP_RETRY_ATTEMPTS=0
ERP_RETRY_BACKOFF_SECONDS=1

# Advanced ERP retry settings (optional, for exponential backoff)
# Maximum timeout for ERP requests (caller can reduce but not exceed this)
ERP_TIMEOUT_MAX_SECONDS=30
# Maximum retry attempts (overrides ERP_RETRY_ATTEMPTS if higher)
ERP_RETRY_MAX_ATTEMPTS=3
# Base backoff seconds (multiplied by 2^(attempt-1) for exponential backoff)
ERP_RETRY_BACKOFF_BASE_SECONDS=1
# Maximum backoff seconds (caps exponential backoff)
ERP_RETRY_BACKOFF_MAX_SECONDS=60
# Random jitter seconds (added to backoff for thundering herd prevention)
ERP_RETRY_JITTER_SECONDS=1

# === ERP-AGENT SETTINGS (separate from print jobs) ===
# Enable the ERP-agent loop for processing ERP box requests from erp-agent edge function
# This runs alongside the print agent loop without affecting print job processing
ERP_AGENT_ENABLED=false
# URL of the erp-agent edge function
ERP_AGENT_URL=https://your-project.supabase.co/functions/v1/erp-agent
# API key for erp-agent (defaults to PRINT_AGENT_API_KEY if not set)
ERP_AGENT_API_KEY=
# How often to poll for ERP requests (seconds)
ERP_AGENT_POLL_INTERVAL_SECONDS=2
# Maximum concurrent ERP requests to process
ERP_AGENT_MAX_CONCURRENT_REQUESTS=2

# Log file path (for background daemon mode)
# When running in daemon mode (--daemon), logs are written to this file
LOG_FILE=print_agent.log

# Workstation identifier (auto-generated on first run, do not edit manually)
# This unique ID allows the backend to track which workstation printed which job
WORKSTATION_ID=

# Job claiming timeout (seconds)
# Jobs in 'processing' status longer than this are considered stale and will be
# recovered automatically. Set this higher than your expected print duration.
STALE_JOB_TIMEOUT_SECONDS=300
